@model Bookstore.Models.Book

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Book</h4>
    <hr />
    <dl class="row container">
        <dt class="col-sm-2 mt-3">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10 mt-3">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class="col-sm-2 mt-3">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-10 mt-3">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class="col-sm-2 mt-3">
            @Html.DisplayNameFor(model => model.Author.FullName)
        </dt>
        <dd class="col-sm-10 mt-3">
            @Html.DisplayFor(model => model.Author.FullName)
        </dd>
        <dt class="col-sm-2 mt-3">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10 mt-3">
            @Html.DisplayFor(model => model.Description)
        </dd>

        @if (!Model.ImageURL.Equals(string.Empty))
        {
            <dt class="col-sm-2 mt-3">
                Image
            </dt>
            <dd class="col-sm-10 mt-3">

                <img src="~/Uploads/@Model.ImageURL" class="img-thumbnail" style="width:120px" />
            </dd>
        } 
    </dl>
</div>
<div>
    @Html.ActionLink("Edit", "Edit", new { id = Model.Id }, new { @class = "btn btn-primary" })
    <a asp-action="Index" class="btn btn-outline-info">Back to List</a>
</div>
